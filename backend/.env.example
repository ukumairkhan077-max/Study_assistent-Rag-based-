# Copy to backend/.env and fill in. NEVER commit backend/.env.
# ---------------- LLM (any OpenAI-compatible chat-completions API) ----------------
# Get these from your provider's official docs / dashboard (API key page, model list, base URL).
# Examples of the *shape* of a base URL (check your provider's docs, do not guess):
#   https://api.openai.com/v1      |  https://<provider-host>/openai/v1   |  http://localhost:11434/v1 (Ollama)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=3
# Some providers use another parameter name / reject temperature (reasoning models):
LLM_MAX_TOKENS_PARAM=max_tokens
LLM_SEND_TEMPERATURE=true

# ---------------- Local models (downloaded once from Hugging Face, CPU only) ----------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------- Storage ----------------
# Leave unset to use backend/chroma_db and backend/data
# CHROMA_PATH=C:\path\to\chroma_db
# DATA_DIR=C:\path\to\data

# ---------------- Chunking (characters) ----------------
CHUNK_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=80
PARENT_CHUNK_SIZE=1800

# ---------------- Behaviour ----------------
MIN_RELEVANCE=0.25
CONTEXT_TOKEN_BUDGET=3000
MAX_UPLOAD_MB=25
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
